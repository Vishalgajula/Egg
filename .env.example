# Firebase web config. Copy to .env.local and fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app.
#
# Full walkthrough: docs/FIREBASE.md
#
# Leave these unset and the app runs entirely on browser storage, exactly as
# the offline prototype. That fallback is intentional - a fresh clone works
# with no Firebase project at all.
#
# These values ship in the JavaScript bundle and are meant to be public. They
# identify the project; they do not authorise anything. Access control lives
# entirely in firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
